# Bu fayl faqat NAMUNA. Haqiqiy qiymatlarni .env fayliga yozing,
# .env hech qachon git'ga qo'shilmaydi (.gitignore'da).
#
# Kalitlarni generatsiya qilish uchun README.md ga qarang
# (masalan: openssl rand -hex 32).

# Telegram bot tokeni (@BotFather'dan olinadi)
BOT_TOKEN=

# MongoDB ulanish satri — albatta autentifikatsiya bilan
# (username:password@host yoki Atlas SRV satri)
MONGODB_URI=

# Express server porti
PORT=3000

# Server qaysi interfeysda tinglaydi. Standart 127.0.0.1 — faqat shu
# mashinadagi nginx unga murojaat qila oladi, tashqi tarmoqdan
# to'g'ridan-to'g'ri kirish yo'q. Faqat lokal rivojlantirishda boshqa
# qurilmadan sinash kerak bo'lsa 0.0.0.0 ga o'zgartiring.
HOST=127.0.0.1

# PINFL'ni AES-256-GCM bilan shifrlash uchun kalit (32 bayt, hex)
# Generatsiya: openssl rand -hex 32
ENCRYPTION_KEY=

# PINFL bo'yicha duplikat qidirish uchun HMAC-SHA256 kaliti (32 bayt, hex)
# Generatsiya: openssl rand -hex 32
HMAC_SECRET=

# Kassir stansiyasi API tokenlarini xashlash uchun tuz (salt)
# Generatsiya: openssl rand -hex 32
STATION_API_SALT=
